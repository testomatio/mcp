{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "testomatio-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "TESTOMATIO_BASE_URL": "https://app.testomat.io"
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "replace-with-your-kv-namespace-id"
    }
  ],
  "env": {
    "beta": {
      "name": "testomatio-mcp-beta",
      "vars": {
        "TESTOMATIO_BASE_URL": "https://beta.testomat.io"
      },
      "kv_namespaces": [
        {
          "binding": "OAUTH_KV",
          "id": "replace-with-your-beta-kv-namespace-id"
        }
      ]
    }
  }
}
