            "type": "string",
          },
          "labels": {
            "description": "(list)",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "link": {
            "description": "(create|update)",
            "items": {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "enum": [
