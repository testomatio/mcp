          },
          "per_page": {
            "description": "(list|issues_list)",
            "maximum": 100,
            "minimum": 1,
            "type": "integer",
          },
          "plan_id": {
            "description": "(get|update|delete|issues_list|issues_link)",
            "type": "string",
          },
          "search_text": {
            "description": "(list)",
            "type": "string",
